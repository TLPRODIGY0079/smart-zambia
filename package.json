{
  "name": "smart-zambia-frontend",
  "version": "1.0.0",
  "description": "Smart Zambia - Production Build",
  "scripts": {
    "build": "tailwindcss -i ./smart-zambia-frontend/css/input.css -o ./smart-zambia-frontend/css/output.css --minify",
    "build:watch": "tailwindcss -i ./smart-zambia-frontend/css/input.css -o ./smart-zambia-frontend/css/output.css --watch",
    "build:public": "tailwindcss -i ./smart-zambia-frontend/css/input.css -o ./public/css/output.css --minify",
    "build:all": "npm run build && npm run build:public"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  }
}
